<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Counter App</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    keyframes: {
                        pop: {
                            '0%': { transform: 'scale(0.95)' },
                            '50%': { transform: 'scale(1.05)' },
                            '100%': { transform: 'scale(1)' },
                        },
                        pulseGlow: {
                            '0%, 100%': { boxShadow: '0 0 25px -5px rgba(99, 102, 241, 0.3)' },
                            '50%': { boxShadow: '0 0 35px 5px rgba(99, 102, 241, 0.5)' },
                        }
                    },
                    animation: {
                        pop: 'pop 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275)',
                        pulseGlow: 'pulseGlow 3s infinite',
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom scrollbar styling */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.3);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(156, 163, 175, 0.5);
        }
    </style>
</head>

<body class="bg-slate-900 text-slate-100 font-sans min-h-full flex flex-col justify-between selection:bg-indigo-500 selection:text-white antialiased">

    <!-- Top Navigation Header -->
    <header class="w-full border-b border-slate-800 bg-slate-900/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="p-2 bg-indigo-600/20 text-indigo-400 rounded-xl border border-indigo-500/30">
                    <i data-lucide="calculator" class="w-5 h-5"></i>
                </div>
                <h1 class="font-bold text-lg tracking-tight bg-gradient-to-r from-white via-slate-200 to-indigo-300 bg-clip-text text-transparent">
                    Counter Web App
                </h1>
            </div>

            <!-- Quick Action Toggle Buttons -->
            <div class="flex items-center gap-2">
                <button id="soundToggleBtn" title="Toggle Sound (M)" class="p-2 rounded-xl border border-slate-800 bg-slate-800/50 hover:bg-slate-800 text-slate-300 hover:text-white transition-all flex items-center gap-1.5 text-xs font-medium">
                    <i id="soundIcon" data-lucide="volume-2" class="w-4 h-4 text-indigo-400"></i>
                    <span class="hidden sm:inline">Sound</span>
                </button>
                <button id="resetAppBtn" title="Reset Counter & Settings" class="p-2 rounded-xl border border-slate-800 bg-slate-800/50 hover:bg-rose-950/40 hover:border-rose-800/50 text-slate-300 hover:text-rose-400 transition-all flex items-center gap-1.5 text-xs font-medium">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">Reset</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-4xl w-full mx-auto p-4 sm:p-6 flex flex-col justify-center items-center gap-6">

        <div class="w-full max-w-xl bg-slate-800/60 backdrop-blur-xl border border-slate-700/60 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden animate-pulseGlow">
            <!-- Background Glow Decor -->
            <div class="absolute -top-24 -left-24 w-48 h-48 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-violet-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Display Header / Title -->
            <div class="flex items-center justify-between mb-4">
                <span id="targetStatus" class="text-xs font-semibold uppercase tracking-wider text-indigo-400 bg-indigo-950/80 px-3 py-1 rounded-full border border-indigo-800/50">
                    Active Counter
                </span>
                <span id="timestamp" class="text-xs text-slate-400 font-mono">
                    Updated just now
                </span>
            </div>

            <!-- Counter Number Display -->
            <div class="flex flex-col items-center justify-center my-6 py-4">
                <div id="counterContainer" class="transition-transform duration-100 ease-out">
                    <span id="counterValue" class="font-mono text-7xl sm:text-8xl font-extrabold tracking-tight text-white drop-shadow-lg select-none">
                        0
                    </span>
                </div>
                <!-- Min / Max Limits Warning -->
                <p id="limitWarning" class="h-5 mt-2 text-xs font-medium text-amber-400 opacity-0 transition-opacity duration-200">
                    Reached limit boundary!
                </p>
            </div>

            <!-- Main Controls Grid -->
            <div class="grid grid-cols-3 gap-3 sm:gap-4 mt-2">
                <!-- Decrement Button -->
                <button id="decrementBtn" class="flex flex-col items-center justify-center py-4 px-2 rounded-2xl bg-slate-700/60 hover:bg-slate-700 active:scale-95 border border-slate-600/50 hover:border-slate-500 transition-all group cursor-pointer">
                    <i data-lucide="minus" class="w-8 h-8 text-indigo-400 group-hover:scale-110 transition-transform"></i>
                    <span class="text-xs font-semibold text-slate-300 mt-1">Subtract</span>
                </button>

                <!-- Reset Button -->
                <button id="quickResetBtn" class="flex flex-col items-center justify-center py-4 px-2 rounded-2xl bg-slate-700/40 hover:bg-slate-700/70 active:scale-95 border border-slate-600/40 hover:border-slate-500 transition-all group cursor-pointer">
                    <i data-lucide="refresh-cw" class="w-6 h-6 text-slate-400 group-hover:rotate-180 transition-transform duration-500"></i>
                    <span class="text-xs font-semibold text-slate-400 mt-1">Zero</span>
                </button>

                <!-- Increment Button -->
                <button id="incrementBtn" class="flex flex-col items-center justify-center py-4 px-2 rounded-2xl bg-indigo-600 hover:bg-indigo-500 active:scale-95 border border-indigo-400/40 shadow-lg shadow-indigo-600/20 group cursor-pointer">
                    <i data-lucide="plus" class="w-8 h-8 text-white group-hover:scale-110 transition-transform"></i>
                    <span class="text-xs font-bold text-white mt-1">Add</span>
                </button>
            </div>

            <!-- Controls & Settings Panel -->
            <div class="mt-8 pt-6 border-t border-slate-700/50 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Step Size Preset Selector -->
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-2">Step Increment</label>
                    <div class="flex items-center gap-1.5" id="stepPresets">
                        <button data-step="1" class="step-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white border border-indigo-500">1</button>
                        <button data-step="5" class="step-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700/60 text-slate-300 hover:bg-slate-700 border border-slate-600/50">5</button>
                        <button data-step="10" class="step-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700/60 text-slate-300 hover:bg-slate-700 border border-slate-600/50">10</button>
                        <button data-step="100" class="step-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700/60 text-slate-300 hover:bg-slate-700 border border-slate-600/50">100</button>
                        <input type="number" id="customStepInput" placeholder="Custom" min="1" max="9999" class="w-16 px-2 py-1.5 bg-slate-900/60 border border-slate-700 rounded-lg text-xs text-white text-center focus:outline-none focus:border-indigo-500">
                    </div>
                </div>

                <!-- Limits Toggle & Inputs -->
                <div>
                    <label class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2">
                        <span>Bounds Limits</span>
                        <input type="checkbox" id="enableLimitsToggle" class="rounded accent-indigo-500 cursor-pointer">
                    </label>
                    <div id="limitsContainer" class="flex items-center gap-2 opacity-50 pointer-events-none transition-opacity">
                        <div class="flex-1">
                            <input type="number" id="minLimitInput" placeholder="Min" value="-100" class="w-full px-2.5 py-1.5 bg-slate-900/60 border border-slate-700 rounded-lg text-xs text-white text-center focus:outline-none focus:border-indigo-500">
                        </div>
                        <span class="text-xs text-slate-500">to</span>
                        <div class="flex-1">
                            <input type="number" id="maxLimitInput" placeholder="Max" value="100" class="w-full px-2.5 py-1.5 bg-slate-900/60 border border-slate-700 rounded-lg text-xs text-white text-center focus:outline-none focus:border-indigo-500">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Keyboard Hints -->
            <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-[11px] text-slate-400">
                <span class="inline-flex items-center gap-1 bg-slate-900/60 px-2 py-1 rounded border border-slate-800"><kbd class="font-mono bg-slate-800 px-1 rounded text-indigo-300">↑</kbd> Add</span>
                <span class="inline-flex items-center gap-1 bg-slate-900/60 px-2 py-1 rounded border border-slate-800"><kbd class="font-mono bg-slate-800 px-1 rounded text-indigo-300">↓</kbd> Subtract</span>
                <span class="inline-flex items-center gap-1 bg-slate-900/60 px-2 py-1 rounded border border-slate-800"><kbd class="font-mono bg-slate-800 px-1 rounded text-indigo-300">R</kbd> Reset</span>
                <span class="inline-flex items-center gap-1 bg-slate-900/60 px-2 py-1 rounded border border-slate-800"><kbd class="font-mono bg-slate-800 px-1 rounded text-indigo-300">M</kbd> Mute</span>
            </div>
        </div>

        <!-- Recent History Section -->
        <div class="w-full max-w-xl bg-slate-800/40 backdrop-blur-md border border-slate-800 rounded-2xl p-4 sm:p-5">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
                    <i data-lucide="history" class="w-4 h-4 text-indigo-400"></i>
                    <span>Activity History</span>
                </div>
                <button id="clearHistoryBtn" class="text-[11px] text-slate-400 hover:text-slate-200 hover:underline">Clear History</button>
            </div>
            
            <div id="historyList" class="max-h-36 overflow-y-auto space-y-1.5 pr-1 text-xs">
                <div class="text-slate-500 text-center py-4 italic">No recent activity recorded yet.</div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="w-full py-4 text-center text-xs text-slate-500 border-t border-slate-800/60">
        Created with HTML, Tailwind CSS & JavaScript
    </footer>

    <script>
        // App State Object
        const state = {
            count: 0,
            step: 1,
            soundEnabled: true,
            limitsEnabled: false,
            minLimit: -100,
            maxLimit: 100,
            history: []
        };

        // DOM Element Selectors
        const counterValueEl = document.getElementById('counterValue');
        const counterContainerEl = document.getElementById('counterContainer');
        const limitWarningEl = document.getElementById('limitWarning');
        const incrementBtn = document.getElementById('incrementBtn');
        const decrementBtn = document.getElementById('decrementBtn');
        const quickResetBtn = document.getElementById('quickResetBtn');
        const resetAppBtn = document.getElementById('resetAppBtn');
        const soundToggleBtn = document.getElementById('soundToggleBtn');
        const soundIcon = document.getElementById('soundIcon');
        const customStepInput = document.getElementById('customStepInput');
        const stepPresets = document.getElementById('stepPresets');
        const enableLimitsToggle = document.getElementById('enableLimitsToggle');
        const limitsContainer = document.getElementById('limitsContainer');
        const minLimitInput = document.getElementById('minLimitInput');
        const maxLimitInput = document.getElementById('maxLimitInput');
        const historyList = document.getElementById('historyList');
        const clearHistoryBtn = document.getElementById('clearHistoryBtn');
        const timestampEl = document.getElementById('timestamp');

        // Web Audio API Synthesizer Sound Generator
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        function playTone(freq, type = 'sine', duration = 0.08) {
            if (!state.soundEnabled) return;
            try {
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {
                console.warn('Audio playback inhibited', e);
            }
        }

        // Load State from LocalStorage
        function loadSavedState() {
            try {
                const saved = localStorage.getItem('counter_app_state');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    state.count = parsed.count ?? 0;
                    state.step = parsed.step ?? 1;
                    state.soundEnabled = parsed.soundEnabled ?? true;
                    state.limitsEnabled = parsed.limitsEnabled ?? false;
                    state.minLimit = parsed.minLimit ?? -100;
                    state.maxLimit = parsed.maxLimit ?? 100;
                    state.history = parsed.history ?? [];
                }
            } catch (e) {
                console.error('Error loading saved state:', e);
            }
        }

        // Save State to LocalStorage
        function saveState() {
            try {
                localStorage.setItem('counter_app_state', JSON.stringify(state));
            } catch (e) {
                console.error('Error saving state:', e);
            }
        }

        // UI Sync Function
        function updateUI() {
            // Update counter text
            counterValueEl.textContent = state.count.toLocaleString();
            
            // Adjust step button active highlights
            document.querySelectorAll('.step-btn').forEach(btn => {
                const btnStep = parseInt(btn.dataset.step, 10);
                if (btnStep === state.step) {
                    btn.className = 'step-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white border border-indigo-500';
                } else {
                    btn.className = 'step-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-700/60 text-slate-300 hover:bg-slate-700 border border-slate-600/50';
                }
            });

            // Limits state
            enableLimitsToggle.checked = state.limitsEnabled;
            if (state.limitsEnabled) {
                limitsContainer.classList.remove('opacity-50', 'pointer-events-none');
            } else {
                limitsContainer.classList.add('opacity-50', 'pointer-events-none');
            }

            minLimitInput.value = state.minLimit;
            maxLimitInput.value = state.maxLimit;

            // Sound Icon Toggle
            if (state.soundEnabled) {
                soundIcon.setAttribute('data-lucide', 'volume-2');
                soundToggleBtn.classList.remove('opacity-60');
            } else {
                soundIcon.setAttribute('data-lucide', 'volume-x');
                soundToggleBtn.classList.add('opacity-60');
            }
            lucide.createIcons();

            // Render History
            renderHistory();
            saveState();
        }

        // Add Log Entry to History
        function logHistory(action, delta) {
            const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            state.history.unshift({
                action,
                delta,
                result: state.count,
                timestamp: timeStr
            });
            // Keep maximum 20 recent history entries
            if (state.history.length > 20) {
                state.history.pop();
            }
            renderHistory();
        }

        function renderHistory() {
            if (!state.history.length) {
                historyList.innerHTML = `<div class="text-slate-500 text-center py-4 italic">No recent activity recorded yet.</div>`;
                return;
            }

            historyList.innerHTML = state.history.map(item => {
                const isPositive = item.delta > 0;
                const isNeutral = item.delta === 0;
                const badgeColor = isNeutral 
                    ? 'bg-slate-700 text-slate-300' 
                    : isPositive 
                        ? 'bg-emerald-950/80 text-emerald-400 border-emerald-800/40' 
                        : 'bg-rose-950/80 text-rose-400 border-rose-800/40';
                
                const sign = isPositive ? '+' : '';

                return `
                    <div class="flex items-center justify-between p-2 rounded-xl bg-slate-900/50 border border-slate-800">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-mono border ${badgeColor}">
                                ${isNeutral ? 'RESET' : sign + item.delta}
                            </span>
                            <span class="text-slate-300 font-medium">${item.action}</span>
                        </div>
                        <div class="flex items-center gap-3 font-mono">
                            <span class="text-slate-400">Total: <strong class="text-white">${item.result}</strong></span>
                            <span class="text-[10px] text-slate-500">${item.timestamp}</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Animate counter pop effect
        function triggerPopAnimation() {
            counterContainerEl.classList.remove('animate-pop');
            void counterContainerEl.offsetWidth; // Trigger reflow
            counterContainerEl.classList.add('animate-pop');
        }

        // Show Limit Warning
        function showLimitWarning(msg) {
            limitWarningEl.textContent = msg;
            limitWarningEl.classList.remove('opacity-0');
            setTimeout(() => {
                limitWarningEl.classList.add('opacity-0');
            }, 1800);
        }

        // Change Counter Value Core Function
        function updateCounter(delta) {
            let nextValue = state.count + delta;

            if (state.limitsEnabled) {
                if (nextValue > state.maxLimit) {
                    showLimitWarning(`Maximum limit (${state.maxLimit}) reached!`);
                    playTone(220, 'sawtooth', 0.15);
                    return;
                }
                if (nextValue < state.minLimit) {
                    showLimitWarning(`Minimum limit (${state.minLimit}) reached!`);
                    playTone(220, 'sawtooth', 0.15);
                    return;
                }
            }

            state.count = nextValue;
            triggerPopAnimation();

            if (delta > 0) {
                playTone(520 + Math.min(state.count * 2, 400), 'sine', 0.08);
                logHistory('Incremented', delta);
            } else if (delta < 0) {
                playTone(380, 'sine', 0.08);
                logHistory('Decremented', delta);
            }

            timestampEl.textContent = 'Updated ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            updateUI();
        }

        // Reset Counter to 0
        function resetCounter() {
            if (state.count === 0) return;
            state.count = 0;
            triggerPopAnimation();
            playTone(300, 'triangle', 0.12);
            logHistory('Reset to zero', 0);
            updateUI();
        }

        // Click Event Listeners
        incrementBtn.addEventListener('click', () => updateCounter(state.step));
        decrementBtn.addEventListener('click', () => updateCounter(-state.step));
        quickResetBtn.addEventListener('click', resetCounter);
        resetAppBtn.addEventListener('click', () => {
            state.count = 0;
            state.step = 1;
            state.history = [];
            updateUI();
            playTone(250, 'square', 0.15);
        });

        // Sound Toggle
        soundToggleBtn.addEventListener('click', () => {
            state.soundEnabled = !state.soundEnabled;
            updateUI();
        });

        // Preset Step Buttons
        stepPresets.addEventListener('click', (e) => {
            const btn = e.target.closest('.step-btn');
            if (btn && btn.dataset.step) {
                state.step = parseInt(btn.dataset.step, 10);
                customStepInput.value = '';
                updateUI();
            }
        });

        // Custom Step Input
        customStepInput.addEventListener('input', (e) => {
            const val = parseInt(e.target.value, 10);
            if (!isNaN(val) && val > 0) {
                state.step = val;
                updateUI();
            }
        });

        // Bounds Toggle & Inputs
        enableLimitsToggle.addEventListener('change', (e) => {
            state.limitsEnabled = e.target.checked;
            updateUI();
        });

        minLimitInput.addEventListener('change', (e) => {
            const val = parseInt(e.target.value, 10);
            if (!isNaN(val)) {
                state.minLimit = val;
                updateUI();
            }
        });

        maxLimitInput.addEventListener('change', (e) => {
            const val = parseInt(e.target.value, 10);
            if (!isNaN(val)) {
                state.maxLimit = val;
                updateUI();
            }
        });

        // Clear History Button
        clearHistoryBtn.addEventListener('click', () => {
            state.history = [];
            renderHistory();
            saveState();
        });

        // Keyboard Shortcuts Handler
        window.addEventListener('keydown', (e) => {
            // Ignore keystrokes when typing in input fields
            if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;

            if (e.key === 'ArrowUp' || e.key === ' ' || e.key === '+') {
                e.preventDefault();
                updateCounter(state.step);
            } else if (e.key === 'ArrowDown' || e.key === '-') {
                e.preventDefault();
                updateCounter(-state.step);
            } else if (e.key.toLowerCase() === 'r') {
                e.preventDefault();
                resetCounter();
            } else if (e.key.toLowerCase() === 'm') {
                e.preventDefault();
                state.soundEnabled = !state.soundEnabled;
                updateUI();
            }
        });

        // Initialize App on Window Load
        window.onload = function() {
            lucide.createIcons();
            loadSavedState();
            updateUI();
        };
    </script>
</body>
</html>
